<% if session[:recent_product_ids].present? && !(current_user&.admin_flg) %>
  <% recent_products = Product.where(id: session[:recent_product_ids]).index_by(&:id) %>
  <div class="viewed-products">
    <h4>見た商品</h4>
    <% session[:recent_product_ids].each do |product_id| %>
      <% product = recent_products[product_id] %>
      <% next if product.blank? %>
      <div class="viewed-product-card">
        <% if product.photo.attached? %>
            <%= image_tag product.thumbnail %>
        <% end %>
        <br>
        <%= link_to product.name, product_path(product) %>
      </div>
    <% end %>
  </div>
<% end %>